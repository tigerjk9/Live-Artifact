 "daily": [
  {
   "d": "2025-12-01",
   "n": 25,
   "head": "AI 활용 및 부정행위 방지, 미래 교육 시스템 구축, 뇌과학 기반 학습법 도입 등 교육 혁신을 통해 미래 인재 양성을 위한 긍정적인 변화가 가속화되고 있다.",
   "src": "note"
  },
  {
   "d": "2025-12-02",
   "n": 25,
   "head": "AI와 뇌과학에 대한 관심이 높아지는 가운데, 교육 현장에서는 개방형 교육과정, 디지털 전환, 인문학적 소양 함양 등을 통해 미래 인재 육성을 위한 혁신적인 변화를 적극적으로 모색하고 있다.",
   "src": "note"
  },
  {
   "d": "2025-12-03",
   "n": 25,
   "head": "AI 시대, 디지털 기반 교육 환경 조성과 미래 교육 ODA 확대 속에 고교학점제 및 유아교육 공공성 강화 논의가 활발하며, 프롬프트 리터러시 교육의 중요성이 부각되는 등 교육 혁신을 위한 다각적인 노력이 이루어지고 있다.",
   "src": "note"
  },
  {
   "d": "2025-12-04",
   "n": 25,
   "head": "인공지능(AI)과 뇌과학을 융합하여 교육 혁신을 모색하고, 예술치료 및 잠재력 중심 교육을 통해 미래 사회에 필요한 역량을 키우는 긍정적인 변화가 교육 현장에서 가속화되고 있다.",
   "src": "note"
  },
  {
   "d": "2025-12-05",
   "n": 25,
   "head": "AI 시대에 발맞춰 인재 양성을 강조하고, 디지털 교육과 에듀테크를 적극적으로 도입하여 미래 교육 모델을 구축하려는 움직임이 활발하게 진행 중이다.",
   "src": "note"
  },
  {
   "d": "2025-12-06",
   "n": 10,
   "head": "AI 기술을 교육에 적극적으로 도입하고, 미래 교육 혁신을 위한 대학들의 노력이 가속화되는 가운데, 융합적 사고와 특수 교육 지원 강화의 중요성이 부각되며 교육의 미래를 향한 변화가 빠르게 진행되고 있다.",
   "src": "note"
  },
  {
   "d": "2025-12-07",
   "n": 10,
   "head": "AI 기반 맞춤형 교육, IB 교육과정 도입, 에듀테크 활용, 글로벌 교육 교류 확대 등 교육 혁신을 통해 미래 사회를 준비하는 움직임이 활발하게 나타나고 있다.",
   "src": "note"
  }
 ],
