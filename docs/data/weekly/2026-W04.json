 "daily": [
  {
   "d": "2026-01-19",
   "n": 25,
   "head": "AI 시대, 디지털 교육 협력 강화 및 혁신적인 교육 정책 확산 노력과 함께, 교육감 선거 및 교육 혁신에 대한 다양한 논의가 이루어지며, 공교육 혁신을 통해 글로벌 교육 경쟁력 강화에 힘쓰는 긍정적인 변화가 교육 현장에서 활발하게 진행 중이다.",
   "src": "note"
  },
  {
   "d": "2026-01-20",
   "n": 25,
   "head": "AI와 에듀테크를 활용한 미래 교육 혁신을 위해 교사 역량 강화 및 스마트 교육 환경 구축에 힘쓰며, 학생들의 건강과 균형 잡힌 성장을 위한 다각적인 노력이 이루어지고 있습니다.",
   "src": "note"
  },
  {
   "d": "2026-01-21",
   "n": 25,
   "head": "AI 시대에 발맞춰 교육 혁신 전략이 모색되는 가운데, 뇌과학 연구를 통해 학생들의 심리적 안정과 학습 능력 향상을 돕고, 교사의 능동적인 변화를 촉구하며, 교육의 본질에 더욱 집중하려는 긍정적인 움직임이 나타나고 있다 🚀.",
   "src": "note"
  },
  {
   "d": "2026-01-22",
   "n": 25,
   "head": "AI 기술과 뇌과학 연구를 융합하여 학생들의 사회정서 함양 및 학업 능력 향상을 꾀하고, 미래 교육 혁신을 주도하려는 움직임이 활발하게 나타나고 있다.",
   "src": "note"
  },
  {
   "d": "2026-01-23",
   "n": 25,
   "head": "AI 교육 격차 해소, 맞춤 교육 강화, 교육 혁신을 위한 투자 확대 등, 교육 현장이 미래를 향해 발 빠르게 변화하며 혁신적인 발전을 추구하고 있습니다!",
   "src": "note"
  },
  {
   "d": "2026-01-24",
   "n": 25,
   "head": "AI 시대에 발맞춰 에듀테크 투자와 교육 플랫폼 도입이 활발해지고, 기후 위기 대응 교육과 소외 계층을 위한 교육 기회 확대 노력이 이루어지는 가운데, 교육청의 정책 변화와 미래 교육 방향 모색이 활발하게 진행되며 긍정적인 발전을 가속화하고 있다.",
   "src": "note"
  },
  {
   "d": "2026-01-25",
   "n": 10,
   "head": "지역 교육 혁신, AI 튜터 경쟁, 교육감 선거 등 다양한 움직임 속에서 교육의 질 향상과 미래 교육으로의 전환을 위한 노력이 활발하게 이루어지고 있습니다.",
   "src": "note"
  }
 ],
