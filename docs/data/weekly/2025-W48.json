 "daily": [
  {
   "d": "2025-11-24",
   "n": 25,
   "head": "AI 시대, 교육은 디지털 역량 강화와 지역대학 혁신을 통해 미래 인재 양성에 박차를 가하며, 새로운 교육 방식과 평가 시스템 도입으로 혁신을 꾀하고 있습니다.",
   "src": "note"
  },
  {
   "d": "2025-11-25",
   "n": 25,
   "head": "AI와 에듀테크를 활용하여 교육 혁신을 가속화하고, 교사 역량 강화 및 미래 인재 육성에 집중하는 긍정적인 교육 변화가 전국적으로 확산되고 있다.",
   "src": "note"
  },
  {
   "d": "2025-11-26",
   "n": 25,
   "head": "AI와 디지털 교육 혁신이 교육 현장에 빠르게 도입되고 있으며, 미래 교육 공간 조성과 고교학점제 시행 등 다양한 시도가 이루어지는 가운데, 지역 및 학교별 격차 해소와 책임 교육 강화를 위한 노력이 중요해지고 있습니다.",
   "src": "note"
  },
  {
   "d": "2025-11-27",
   "n": 25,
   "head": "AI, 디지털 교육, 미래 교육 공간 혁신 등 다양한 분야에서 교육 혁신이 활발하게 이루어지고 있으며, 뇌과학 융합 프로그램, 국제 교류, 교수학습 성과 공유 등을 통해 미래 교육으로 나아가기 위한 노력이 다각도로 진행 중이다.",
   "src": "note"
  },
  {
   "d": "2025-11-28",
   "n": 25,
   "head": "AI 시대에 발맞춰 교육 혁신과 디지털 전환이 가속화되는 가운데, 미래 교육을 선도하고 교육 본질을 회복하기 위한 다양한 시도와 국제 협력이 활발하게 이루어지고 있으며, 고교학점제와 같은 새로운 교육 시스템에 대한 엇갈린 평가 속에서도 교육 현장은 긍정적인 변화를 모색",
   "src": "note"
  },
  {
   "d": "2025-11-29",
   "n": 10,
   "head": "AI 시대에 발맞춰 교육 자치 강화, 디지털 교육 협력 확대, AI 교육 의제 논의 활성화 등 교육계 전반에서 AI와 디지털 기술을 적극적으로 도입하고 미래 교육으로 나아가기 위한 노력이 가속화되고 있다.",
   "src": "note"
  },
  {
   "d": "2025-11-30",
   "n": 10,
   "head": "AI 기술 활용 및 윤리적 문제 대응과 함께, 혁신적인 교육 모델 개발 및 재정 효율화 노력을 통해 미래 인재 양성에 박차를 가하는 교육 현장의 긍정적인 변화가 기대된다.",
   "src": "note"
  }
 ],
