 "daily": [
  {
   "d": "2025-12-08",
   "n": 25,
   "head": "AI 활용 교육 혁신, 인성 교육 강화, 학교폭력 및 유해 환경 예방, 그리고 교원 주도 평가 시스템 구축을 통해 미래 교육으로 나아가는 긍정적인 변화가 교육 현장에서 활발하게 진행 중이다.",
   "src": "note"
  },
  {
   "d": "2025-12-09",
   "n": 25,
   "head": "AI 시대에 발맞춰 교육 혁신, 교사의 역할 재정립, 학생 역량 강화, 학교폭력 예방, 국제 협력 확대 등 다각적인 노력을 통해 미래 교육을 위한 긍정적인 변화가 가속화되고 있습니다.",
   "src": "note"
  },
  {
   "d": "2025-12-10",
   "n": 25,
   "head": "AI 교육 확산과 더불어 뇌과학 기반 학습법 연구 및 전통적인 교육 방식의 가치 재조명을 통해 교육 혁신을 꾀하고, 지역 소멸 위기를 극복하려는 긍정적인 움직임이 활발하다.",
   "src": "note"
  },
  {
   "d": "2025-12-11",
   "n": 25,
   "head": "AI 시대, 교육은 사교육 의존에서 벗어나 교사의 성찰과 역량 강화를 통해 디지털 전환을 주도하며, AI 기술을 활용한 맞춤형 미래 교육으로 나아가는 🚀.",
   "src": "note"
  },
  {
   "d": "2025-12-12",
   "n": 25,
   "head": "AI와 에듀테크가 영양 교육부터 한국어 교육 혁신, 미래 교육 방향 설정까지 교육 전반에 걸쳐 긍정적인 변화를 이끌고 있으며, 동시에 윤리 및 문해력 교육 강화, 지역 간 균형 성장, 유아 식습관 개선 등 다각적인 노력을 통해 미래 교육의 질적 성장을 추구하고 있습니다",
   "src": "note"
  },
  {
   "d": "2025-12-13",
   "n": 25,
   "head": "AI 기술과 뇌과학 기반 학습법이 교육 혁신을 주도하고, 교육 불평등 해소 및 AI 인재 양성에 힘쓰며 미래 교육을 향해 나아가는 긍정적인 변화가 돋보입니다.",
   "src": "note"
  },
  {
   "d": "2025-12-14",
   "n": 10,
   "head": "AI 기술을 활용한 미래 교육으로의 전환이 가속화되는 가운데, 디지털 격차 해소, 문해력 강화, 서논술형 평가 확대 등 교육 전반의 혁신을 통해 잠재력을 극대화하려는 움직임이 활발하게 이루어지고 있다.",
   "src": "note"
  }
 ],
